{
  "schema": "ownframework-loop-policy/v1",
  "approved_roots": [
    "/path/to/operator/approved-root"
  ],
  "forbidden_roots": [
    "/path/to/operator-restricted-root-1",
    "/path/to/operator-restricted-root-2"
  ],
  "max_run_wallclock_seconds": 28800,
  "max_pass_runtime_seconds": 1800,
  "model_smoke_budget_usd": 3.00,
  "default_branch": "<baseline-branch>",
  "require_local_only_default": true
}
