#!/usr/bin/env python3
"""OwnFramework Loop CLI shim.

Invokes the deterministic Python core from anywhere on PATH. Adapter inspection is exposed as `ofloop adapter ...` without making the main state CLI vendor-aware.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

os.environ.setdefault("PYTHONDONTWRITEBYTECODE", "1")


def _resolve_lib() -> Path:
    here = Path(__file__).resolve()
    candidate = here.parent.parent / "lib"
    if (candidate / "ownframework_loop").is_dir():
        return candidate
    env = os.environ.get("OFLOOP_LIB")
    if env:
        return Path(env)
    raise RuntimeError("cannot locate ownframework_loop library")


def main() -> int:
    lib = _resolve_lib()
    sys.path.insert(0, str(lib))
    if len(sys.argv) > 1 and sys.argv[1] == "adapter":
        from ownframework_loop import adapter_cli
        return adapter_cli.main(sys.argv[2:], repo_root=lib.parent)
    from ownframework_loop import cli
    return cli.main()


if __name__ == "__main__":
    sys.exit(main())
