def _build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="ofloop-research-broker",
        description=(
            "OwnFramework Loop governed public research broker. Invoked by a "
            "semantic worker through its existing Bash sandbox; NOT a general "
            "HTTP client."
        ),
    )
    p.add_argument("--op", required=True, choices=("ping", "help",
                                                   "search", "read",
                                                   "asset-read"))
    p.add_argument("--url", default=None,
                   help="Target URL (http/https only; userinfo refused).")
    p.add_argument("--query", default=None,
                   help="Search query (for op=search).")
    p.add_argument("--evidence-dir", default=None,
                   help="Operator-owned evidence root for this run.")
    p.add_argument("--run-id", default=None,
                   help="OwnFramework Loop run identity.")
    p.add_argument("--attempt", default=None,
                   help="OwnFramework Loop semantic attempt identity.")
    p.add_argument("--request-id", default=None,
                   help="OwnFramework Loop bridge request UUIDv4.")
    p.add_argument("--request-digest", default=None,
                   help="Deterministic SHA256 of canonical request fields.")
    p.add_argument("--max-bytes", type=int, default=None,
                   help="Maximum bytes (decompressed) for a single response.")
    p.add_argument("--kind", default=None,
                   help="Caller-supplied sub-kind label (free-form text).")
    p.add_argument("--kind-cap", type=int, default=128,
                   help="Maximum bytes for --kind (default 128).")
    p.add_argument("--search-backend", default=None,
                   choices=("wikipedia", "ddg-lite"),
                   help="Provider-neutral search backend (default: wikipedia).")
    return p


# -------------------------------------------------------------------- #
# Subprocess hardening                                                   #
# -------------------------------------------------------------------- #


def _set_resource_limits() -> None:
    """Cap CPU and AS so a corrupt response cannot wedge the host."""
    try:
        resource.setrlimit(resource.RLIMIT_CPU, (60, 60))
    except (OSError, ValueError):
        pass
    try:
        # 512 MB address space cap is generous for a stdlib GET.
        resource.setrlimit(resource.RLIMIT_AS, (512 * 1024 * 1024,
                                                512 * 1024 * 1024))
    except (OSError, ValueError):
        pass


def _ignore_sigpipe() -> None:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)


