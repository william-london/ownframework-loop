            "identity is recorded in the receipt.",
        ],
    }


# -------------------------------------------------------------------- #
# HTTP fetching with re-validated redirects                             #
# -------------------------------------------------------------------- #


class _HttpResponse:
    """Result of one HTTP exchange."""

    __slots__ = ("status_code", "reason", "headers", "body", "connect_log",
                 "final_url", "redirect_chain")

    def __init__(self, status_code: int, reason: str, headers: dict[str, str],
                 body: bytes, connect_log: list[dict[str, Any]],
                 final_url: str, redirect_chain: list[str]) -> None:
        self.status_code = status_code
        self.reason = reason
        self.headers = headers
        self.body = body
        self.connect_log = connect_log
        self.final_url = final_url
        self.redirect_chain = redirect_chain


def _parse_status_line(line: str) -> tuple[int, str]:
    """Parse 'HTTP/1.1 200 OK' -> (200, 'OK')."""
    parts = line.split(" ", 2)
    if len(parts) < 2:
        raise InvalidRequest("response status line malformed")
    try:
        code = int(parts[1])
    except ValueError:
        raise InvalidRequest(f"response status code unparseable: {parts[1]!r}")
    return code, parts[2] if len(parts) > 2 else ""


def _parse_headers(header_blob: bytes) -> dict[str, str]:
    """Parse raw HTTP headers with case-insensitive keys; value is the
    *combined* (comma-joined) value for repeated headers."""
    raw = header_blob.decode("iso-8859-1", errors="replace")
    out: dict[str, str] = {}
    for line in raw.splitlines():
        if not line or ":" not in line:
            continue
        k, _, v = line.partition(":")
        k_lc = k.strip().lower()
        v_clean = v.strip()
        if k_lc in out:
            out[k_lc] = out[k_lc] + ", " + v_clean
        else:
            out[k_lc] = v_clean
    return out


def _read_capped(sock: socket.socket, max_bytes: int, timeout: float) -> bytes:
    """Read until the server closes or max_bytes is exceeded. Returns the
    raw bytes. Raises PayloadTooLarge if the cap is hit (and closes the
    socket to stop further data)."""
    pieces: list[bytes] = []
    total = 0
    sock.settimeout(timeout)
    while True:
        try:
            chunk = sock.recv(64 * 1024)
        except socket.timeout as exc:
            raise TransientFailure(f"read timeout after {total} bytes") from exc
        if not chunk:
            break
        total += len(chunk)
        pieces.append(chunk)
        if total > max_bytes:
            try:
                sock.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            raise PayloadTooLarge(
                f"response exceeded {max_bytes}-byte cap at {total} bytes"
            )
    return b"".join(pieces)


def _browse(url: str, max_bytes: int, *, max_redirects: int = READ_MAX_REDIRECTS,
            accept: str = "*/*",
            ) -> _HttpResponse:
    """Fetch ``url`` with re-validated redirects and a hard byte cap.

    Returns the final response (the broker refuses to interpret, so a 4xx
    is just a 4xx here). The redirect chain is recorded on the response
    so callers (and the receipt writer) can show what happened.
    """
    chain: list[str] = []
    connect_log: list[dict[str, Any]] = []
    current_url = url
    for hop in range(max_redirects + 1):
        u = _parse_url(current_url)
        if u.scheme not in {"http", "https"}:
            raise SSRFRefused(
                f"redirect to non-http(s) scheme refused: {current_url!r}"
            )
        if u.userinfo:
            raise ForbiddenHeader("redirect target contains userinfo")
        accepted = _resolve_and_validate(u.host)
        connect_log.append({
            "url": current_url,
            "host": u.host,
            "addresses": [[socket.AddressFamily(f).name, a] for f, a in accepted],
        })
        port = u.port if u.port is not None else (
            443 if u.scheme == "https" else 80
        )
        # Try each accepted address in order; first success wins.
        last_exc: Exception | None = None
        sock: socket.socket | None = None
        chosen: tuple[int, str] | None = None
        for fam, addr in accepted:
            try:
                s = socket.create_connection(
                    (addr, port), timeout=READ_CONNECT_TIMEOUT
                )
                sock = s
                chosen = (fam, addr)
                break
            except OSError as exc:
                last_exc = exc
                continue
        if sock is None or chosen is None:
            raise TransientFailure(
                f"connect refused to {u.host}: {last_exc}"
            )
        try:
            if u.scheme == "https":
                ctx = _ssl.create_default_context()
                sock = ctx.wrap_socket(sock, server_hostname=u.host)
            path = u.path or "/"
            if u.query:
                path = f"{path}?{u.query}"
            # Manually compose a minimal HTTP/1.1 GET. http.client would
            # work but emits a small surface (still vulnerable to proxies
            # deciding to add weird headers). The raw request stays under
            # our control.
            request_lines = [
                f"GET {path} HTTP/1.1",
                f"Host: {u.host}",
                f"User-Agent: {SEARCH_USER_AGENT}",
                "Accept: " + accept,
                "Accept-Encoding: identity",
                "Connection: close",
                "",  # CRLF terminator
            ]
            request_blob = ("\r\n".join(request_lines) + "\r\n").encode("ascii")
            sock.sendall(request_blob)
            # Read status line + headers
            sock.settimeout(READ_READ_TIMEOUT)
            head = b""
            while b"\r\n\r\n" not in head:
                chunk = sock.recv(4096)
                if not chunk:
                    raise TransientFailure("server closed before headers")
                head += chunk
                if len(head) > 64 * 1024:
                    raise TransientFailure("response headers too large")
            header_blob, _, rest = head.partition(b"\r\n\r\n")
            status_line, _, header_lines = header_blob.partition(b"\r\n")
            code, reason = _parse_status_line(status_line.decode("iso-8859-1", "replace"))
            headers = _parse_headers(header_lines)
            # Body handling: if Content-Length present and > max_bytes,
            # refuse early; otherwise read raw body with byte cap.
            cl = headers.get("content-length", "")
            try:
                cl_int = int(cl) if cl else -1
            except ValueError:
                cl_int = -1
            if cl_int > max_bytes:
                try:
                    sock.close()
                except OSError:
                    pass
                raise PayloadTooLarge(
                    f"response Content-Length {cl_int} exceeds cap {max_bytes}"
                )
            if code in {301, 302, 303, 307, 308}:
                location = headers.get("location", "")
                if not location:
                    raise InvalidRequest(
                        "redirect response missing Location header"
                    )
                chain.append(current_url)
                # 303 always converts to GET; 301/302 are historical
                # "follow with same method", which here is always GET.
                # 307/308 preserve method but we only ever use GET.
                # Combine base + relative.
                if location.startswith("/"):
                    joined = f"{u.scheme}://{u.host}{location}"
                elif "://" in location:
                    joined = location
                else:
                    joined = f"{u.scheme}://{u.host}/{location}"
                # Re-validate the next URL by parsing it and re-asserting
                # scheme + host + absence of userinfo + non-private DNS.
                current_url = joined
                if len(chain) >= max_redirects:
                    raise RedirectRefused(
                        f"redirect chain exceeded {max_redirects} hops"
                    )
                continue
            body = rest
            if cl_int < 0:
                # No Content-Length: read until close with cap.
                # Combine `rest` with whatever else remains.
                pieces = [rest] if rest else []
                total = len(rest)
                while True:
                    try:
                        chunk = sock.recv(64 * 1024)
                    except socket.timeout:
                        break  # treat as end
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > max_bytes:
                        try:
                            sock.shutdown(socket.SHUT_RDWR)
                        except OSError:
                            pass
                        raise PayloadTooLarge(
                            f"response exceeded {max_bytes}-byte cap at {total} bytes"
                        )
                    pieces.append(chunk)
                body = b"".join(pieces)
            elif rest:
                # Content-Length was given but body already partially read.
                remaining = cl_int - len(rest)
                if remaining < 0:
                    raise PayloadTooLarge(
                        f"server sent more bytes than Content-Length: {cl_int}"
                    )
                # Read the precise number of remaining bytes with cap.
                pieces = [rest] if rest else []
                total = len(rest)
                while remaining > 0:
                    want = min(remaining, 64 * 1024)
                    try:
                        chunk = sock.recv(want)
                    except socket.timeout as exc:
                        raise TransientFailure("read timeout before Content-Length satisfied") from exc
                    if not chunk:
                        raise TransientFailure("server closed before Content-Length satisfied")
                    remaining -= len(chunk)
                    total += len(chunk)
                    if total > max_bytes:
                        raise PayloadTooLarge(
                            f"response exceeded {max_bytes}-byte cap at {total} bytes"
                        )
                    pieces.append(chunk)
                body = b"".join(pieces)
            return _HttpResponse(
                status_code=code, reason=reason, headers=headers,
                body=body, connect_log=connect_log,
                final_url=current_url, redirect_chain=chain,
            )
        finally:
            try:
                sock.close()
            except OSError:
                pass
    raise RedirectRefused(
        f"too many redirects (>{max_redirects}); final url was {current_url!r}"
    )


# -------------------------------------------------------------------- #
# HTML → text (best-effort, strip scripts/styles)                       #
# -------------------------------------------------------------------- #


class _TextExtractor(_HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self._parts: list[str] = []
        self._skip_stack: list[str] = []

    def handle_starttag(self, tag: str, attrs: Any) -> None:
        if tag in {"script", "style", "noscript", "iframe", "svg"}:
            self._skip_stack.append(tag)

    def handle_endtag(self, tag: str) -> None:
        if self._skip_stack and self._skip_stack[-1] == tag:
            self._skip_stack.pop()

    def handle_data(self, data: str) -> None:
        if self._skip_stack:
            return
        cleaned = data.replace("\r", " ").replace("\n", " ").replace("\t", " ")
        if cleaned.strip():
            self._parts.append(cleaned)

    def text(self) -> str:
        joined = " ".join(self._parts)
        return _re.sub(r"\s+", " ", joined).strip()


class _TitleExtractor(_HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self._in_title = False
        self._buf: list[str] = []

    def handle_starttag(self, tag: str, attrs: Any) -> None:
        if tag == "title":
            self._in_title = True

    def handle_endtag(self, tag: str) -> None:
        if tag == "title" and self._in_title:
            self._in_title = False

    def handle_data(self, data: str) -> None:
        if self._in_title:
            self._buf.append(data)

    def title(self) -> str:
        return _re.sub(r"\s+", " ", "".join(self._buf)).strip()


def _html_to_text(body: bytes, max_chars: int = READ_DEFAULT_MAX_BYTES) -> str:
    """Best-effort HTML → readable text.

    Strips script/style/iframe/svg. Returns at most ``max_chars`` chars.
    Decoding is explicit; the broker is stdlib-only.
    """
    # Use the stdlib parser which auto-detects encoding via meta tags.
    parser = _TextExtractor()
    try:
        parser.feed(body.decode("utf-8", errors="replace"))
    except _UnicodeDecodeError:
        parser.feed(body.decode("iso-8859-1", errors="replace"))
    text = parser.text()
    if len(text) > max_chars:
        text = text[:max_chars] + f" […truncated to {max_chars} chars]"
    return text


def _html_title(body: bytes) -> str:
    parser = _TitleExtractor()
    try:
        parser.feed(body.decode("utf-8", errors="replace"))
    except _UnicodeDecodeError:
        parser.feed(body.decode("iso-8859-1", errors="replace"))
    return parser.title()


# -------------------------------------------------------------------- #
# Evidence persistence                                                  #
# -------------------------------------------------------------------- #


def _safe_under(base: Path, candidate: Path) -> bool:
    """Return True if candidate's resolved path is within ``base``."""
    try:
        candidate.resolve(strict=False).relative_to(base.resolve(strict=False))
        return True
    except ValueError:
        return False


def _op_id() -> str:
    return f"op-{_uuid.uuid4().hex[:16]}"


def _now_iso() -> str:
    return _dt.datetime.now(_dt.timezone.utc).isoformat()


def _publish_evidence(evidence_dir: Path, payload: dict[str, Any]) -> Path:
    """Atomically publish one evidence JSON under evidence_dir/receipts/.

    The directory layout is hardened: 0o700 created on demand, atomic
    replace via O_EXCL tmp+rename, content-addressed by op-id so
    identical receipts never collide and so the file name itself is a
    stable identifier.
    """
    if not evidence_dir.exists() or not evidence_dir.is_dir():
        raise InvalidRequest(
            f"evidence-dir does not exist or is not a directory: {evidence_dir}"
        )
    receipts_dir = evidence_dir / "receipts"
    receipts_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(receipts_dir, 0o700)
    op_id = str(payload.get("op_id") or _op_id())
    payload["op_id"] = op_id
    payload["schema"] = BROKER_OPERATION_SCHEMA
    target = receipts_dir / f"{op_id}.json"
    if target.is_symlink():
        raise InvalidRequest(f"refusing to overwrite symlink receipt: {target}")
    if target.exists():
        raise InvalidRequest(f"op_id collision refused: {target}")
    tmp = receipts_dir / f".{op_id}.{os.getpid()}.{_uuid.uuid4().hex}.tmp"
    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=True, indent=2) + "\n"
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(encoded)
            fh.flush()
            os.fsync(fh.fileno())
        os.link(tmp, target)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass
    return target


def _safe_ext_for_mime(mime: str) -> str:
    """Return a vetted file extension for an asset MIME.

    Extensions are derived from validated MIME, NEVER from URL path.
    """
    mime_l = mime.split(";", 1)[0].strip().lower()
    table = {
        "image/png": ".png",
        "image/jpeg": ".jpg",
        "image/gif": ".gif",
        "image/webp": ".webp",
        "image/avif": ".avif",
        "image/svg+xml": ".svg",
        "application/pdf": ".pdf",
        "font/woff": ".woff",
        "font/woff2": ".woff2",
        "font/ttf": ".ttf",
        "font/otf": ".otf",
        "application/vnd.ms-fontobject": ".eot",
    }
    return table.get(mime_l, ".bin")


def _publish_artifact(
    evidence_dir: Path,
    op_id: str,
    digest: str,
    safe_ext: str,
    data: bytes,
) -> Path:
    """Publish one content-addressed asset under evidence_dir/artifacts/.

    Filename: ``<digest><safe_ext>``. Defense in depth: the resolved
    final path is asserted to remain under the artifacts directory.
    """
    if not evidence_dir.exists() or not evidence_dir.is_dir():
        raise InvalidRequest(
            f"evidence-dir does not exist: {evidence_dir}"
        )
    artifacts_dir = evidence_dir / "artifacts"
    artifacts_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(artifacts_dir, 0o700)
    target = (artifacts_dir / f"{digest}{safe_ext}").resolve(strict=False)
    if not _safe_under(artifacts_dir, target):
        raise InvalidRequest(f"artifact path escaped evidence root: {target}")
    if target.is_symlink():
        raise InvalidRequest(f"refusing to overwrite symlink artifact: {target}")
    if target.exists():
        # Content-addressed: a clash means the bytes are identical; the
        # broker already verified that, so we just return the existing
        # path without rewriting.
        return target
    tmp = artifacts_dir / f".{digest}.{os.getpid()}.{_uuid.uuid4().hex}.tmp"
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.link(tmp, target)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass
    return target


# -------------------------------------------------------------------- #
# Public operations                                                     #
# -------------------------------------------------------------------- #


def _sanitize_query(q: str) -> str:
    """Refuse queries that look like they carry credential-shaped tokens."""
    if not q or not q.strip():
        raise InvalidRequest("query must be a non-empty string")
    patterns = (
        _re.compile(r"\b[A-Za-z0-9_]{40,}\b"),                # opaque long tokens
        _re.compile(r"(?i)\b(gh[oprsu]_[A-Za-z0-9]{20,})\b"),  # GitHub token shapes
        _re.compile(r"-----BEGIN [A-Z ]+-----"),              # PEM blocks
        _re.compile(r"\bAKIA[0-9A-Z]{16}\b"),                  # AWS access key id
    )
    for pat in patterns:
        if pat.search(q):
            raise ForbiddenHeader("query contains credential-shaped token")
    if any(ord(c) < 0x20 or ord(c) == 0x7f for c in q):
        raise InvalidRequest("query contains control characters")
    return unicodedata.normalize("NFKC", q).strip()


def _receipt_base(args: argparse.Namespace, op: str) -> dict[str, Any]:
    """Common fields every receipt includes so audit can attribute
    the operation to its originating bridge request."""
    return {
        "ok": True,
        "op": op,
        "capability": BROKER_CAPABILITY_NAME,
        "version": BROKER_VERSION,
        "broker_sha256": _self_sha256(),
        "op_id": _op_id(),
        "run_id": str(args.run_id),
        "attempt": str(args.attempt),
        "request_id": str(args.request_id or ""),
        "request_digest": str(args.request_digest or ""),
        "kind": str(args.kind or "")[: args.kind_cap],
        "started_at": _now_iso(),
    }


def _search_wikipedia(query: str) -> tuple[list[dict[str, str]], dict[str, Any]]:
    """Wikipedia REST query backend.

    Returns (results, debug). ``debug`` carries enough fields for the
    receipt (status_code, response_bytes, request_url, endpoint, etc.).
    """
    q = _urllib_parse.urlencode({
        "action": "query",
        "list": "search",
        "srsearch": query,
        "srlimit": str(SEARCH_MAX_RESULTS),
        "format": "json",
        "utf8": "1",
    })
    url = f"{SEARCH_DEFAULT_ENDPOINT}?{q}"
    response = _browse(
        url, max_bytes=SEARCH_DEFAULT_MAX_BYTES,
        accept="application/json,text/plain,*/*;q=0.5",
    )
    if response.status_code != 200:
        raise TransientFailure(
            f"wikipedia search backend returned HTTP {response.status_code} {response.reason}"
        )
    try:
        envelope = json.loads(response.body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise InvalidRequest(
            f"wikipedia search backend returned non-JSON envelope: {exc}"
        )
    if not isinstance(envelope, dict):
        raise InvalidRequest("wikipedia search backend envelope is not a JSON object")
    raw_results = (envelope.get("query") or {}).get("search") or []
    if not isinstance(raw_results, list):
        raise InvalidRequest("wikipedia search backend results field is not an array")
    results: list[dict[str, str]] = []
    for r in raw_results:
        if not isinstance(r, dict):
            continue
        title = str(r.get("title") or "")
        if not title:
            continue
        snippet = _re.sub(r"<[^>]+>", "", str(r.get("snippet") or ""))
        snippet = _re.sub(r"\s+", " ", snippet).strip()
        url_part = _urllib_parse.quote(title.replace(" ", "_"))
        results.append({
            "url": f"https://en.wikipedia.org/wiki/{url_part}",
            "title": title,
            "snippet": snippet,
            "pageid": str(r.get("pageid", "")),
        })
        if len(results) >= SEARCH_MAX_RESULTS:
            break
    debug = {
        "status_code": response.status_code,
        "response_bytes": len(response.body),
        "response_sha256": hashlib.sha256(response.body).hexdigest(),
        "redirect_chain": response.redirect_chain,
        "connect_log": response.connect_log,
        "final_url": response.final_url,
        "request_url": url,
        "endpoint": SEARCH_DEFAULT_ENDPOINT,
    }
    return results, debug


def _search_ddg_lite(query: str) -> tuple[list[dict[str, str]], dict[str, Any]]:
    """DuckDuckGo Lite HTML backend (https://lite.duckduckgo.com/lite/).

    The lite endpoint is unauthenticated and HTML-rendered, with no
    anti-bot restrictions on the worker side. We POST-form-encode the
    query and parse the result table. Operator-supplied query only;
    no credentials needed.
    """
    endpoint = "https://lite.duckduckgo.com/lite/"
    body = _urllib_parse.urlencode({"q": query}).encode("utf-8")
    parsed = _urllib_parse.urlparse(endpoint)
    host = parsed.hostname
    if host is None:
        raise InvalidRequest("ddg-lite endpoint unparseable")
    conn = _http_client.HTTPSConnection(
        host, 443, timeout=READ_CONNECT_TIMEOUT,
        context=_ssl.create_default_context(),
    )
    try:
        conn.request(
            "POST", parsed.path or "/", body=body,
            headers={
                "User-Agent": SEARCH_USER_AGENT,
                "Content-Type": "application/x-www-form-urlencoded",
                "Accept": "text/html,application/xhtml+xml",
            },
        )
        resp = conn.getresponse()
        raw = resp.read(SEARCH_DEFAULT_MAX_BYTES + 1)
        if len(raw) > SEARCH_DEFAULT_MAX_BYTES:
            raw = raw[:SEARCH_DEFAULT_MAX_BYTES]
            truncated = True
        else:
            truncated = False
        status_code = resp.status
        reason = resp.reason
    finally:
        conn.close()
    if status_code != 200:
        raise TransientFailure(
            f"ddg-lite search backend returned HTTP {status_code} {reason}"
        )
    text = raw.decode("utf-8", errors="replace")
    # DDG Lite result links live in <a class="result-link" href="..."> and
    # snippets live in <td class="result-snippet">. We grab the pairs.
    link_re = _re.compile(
        r'<a[^>]+class="result-link"[^>]+href="([^"]+)"[^>]*>(.*?)</a>',
        _re.IGNORECASE | _re.DOTALL,
    )
    snippet_re = _re.compile(
        r'<td[^>]+class="result-snippet"[^>]*>(.*?)</td>',
        _re.IGNORECASE | _re.DOTALL,
    )
    raw_links = link_re.findall(text)
    raw_snippets = snippet_re.findall(text)
    results: list[dict[str, str]] = []
    for i, (href, title_html) in enumerate(raw_links):
        title = _re.sub(r"<[^>]+>", "", title_html).strip()
        if not title:
            continue
        snippet_html = raw_snippets[i] if i < len(raw_snippets) else ""
        snippet = _re.sub(r"<[^>]+>", "", snippet_html).strip()
        # DDG sometimes gives redirect-style URLs; pass through as-is —
        # the worker may need to follow them with op=read.
        results.append({
            "url": href,
            "title": title,
            "snippet": snippet,
            "rank": str(i),
        })
        if len(results) >= SEARCH_MAX_RESULTS:
            break
    debug = {
        "status_code": status_code,
        "response_bytes": len(raw),
        "response_sha256": hashlib.sha256(raw).hexdigest(),
        "redirect_chain": [],
        "connect_log": [],
        "final_url": endpoint,
        "request_url": endpoint,
        "endpoint": endpoint,
        "truncated": truncated,
    }
    return results, debug


def _op_search(args: argparse.Namespace) -> dict[str, Any]:
    """op=search: query a public search backend, return top results.

    Provider-neutral: the worker contract is ``--op search --query <q>``.
    The broker chooses the backend (``wikipedia`` or ``ddg-lite``);
    the backend identity is recorded in the receipt so audit can
    attribute the outbound disclosure to a known operator-chosen
    provider. Wikipedia remains the default for stability / no
    credentials; ddg-lite is an additional unauthenticated general-
    public-web discovery backend.
    """
    query = _sanitize_query(args.query or "")
    evidence_dir = Path(args.evidence_dir).expanduser()
    backend = str(args.search_backend or SEARCH_DEFAULT_BACKEND)
    if backend == "wikipedia":
        results, debug = _search_wikipedia(query)
        search_backend_label = "wikipedia-rest-query"
    elif backend == "ddg-lite":
        results, debug = _search_ddg_lite(query)
        search_backend_label = "ddg-lite-html"
    else:  # pragma: no cover -- argparse choices pre-validate
        raise InvalidRequest(f"unknown search backend: {backend!r}")
    op_id = _op_id()
    payload = _receipt_base(args, "search")
    payload.update({
        "finished_at": _now_iso(),
        "query": query,
        "search_backend": search_backend_label,
        "search_backend_kind": backend,
        "search_endpoint": debug["endpoint"],
        "request_url": debug["request_url"],
        "status_code": debug["status_code"],
        "response_bytes": debug["response_bytes"],
        "response_sha256": debug["response_sha256"],
        "redirect_chain": debug["redirect_chain"],
        "connect_log": debug["connect_log"],
        "results": results,
        "results_count": len(results),
        "evidence_received_at": _now_iso(),
    })
    receipt_path = _publish_evidence(evidence_dir, payload)
    return {
        "schema": BROKER_OPERATION_SCHEMA,
        "ok": True,
        "op": "search",
        "op_id": op_id,
        "receipt_path": str(receipt_path),
        "query": query,
        "search_backend": search_backend_label,
        "search_backend_kind": backend,
        "results_count": len(results),
        "results": results,
        "redirect_chain": debug["redirect_chain"],
        "final_url": debug["final_url"],
        "status_code": debug["status_code"],
        "response_bytes": debug["response_bytes"],
        "response_sha256": payload["response_sha256"],
        "broker_version": BROKER_VERSION,
    }


def _op_read(args: argparse.Namespace) -> dict[str, Any]:
    """op=read: fetch a public URL, strip HTML, retain text evidence."""
    url = args.url
    max_bytes = int(args.max_bytes) if args.max_bytes else READ_DEFAULT_MAX_BYTES
    evidence_dir = Path(args.evidence_dir).expanduser()
    response = _browse(url, max_bytes=max_bytes,
                       accept="text/html,application/xhtml+xml,text/plain,application/json")
    if response.status_code != 200:
        raise TransientFailure(
            f"upstream returned HTTP {response.status_code} {response.reason}"
        )
    content_type = (response.headers.get("content-type") or "").lower()
    if content_type.startswith("text/html") or content_type.startswith("application/xhtml+xml"):
        text = _html_to_text(response.body)
        title = _html_title(response.body)
    else:
        # text/plain, application/json, application/xml: return as text.
        try:
            text = response.body.decode("utf-8")
        except UnicodeDecodeError:
            text = response.body.decode("iso-8859-1", errors="replace")
        title = ""
    text_sha = hashlib.sha256(text.encode("utf-8")).hexdigest()
    op_id = _op_id()
    payload = _receipt_base(args, "read")
    payload.update({
        "finished_at": _now_iso(),
        "url_original": url,
        "url_final": response.final_url,
        "redirect_chain": response.redirect_chain,
        "connect_log": response.connect_log,
        "status_code": response.status_code,
        "content_type": content_type,
        "title": title,
        "response_bytes": len(response.body),
        "response_sha256": hashlib.sha256(response.body).hexdigest(),
        "extracted_bytes": len(text),
        "extracted_sha256": text_sha,
        "extracted_preview": text[:READ_TEXT_PREVIEW_BYTES],
        "extracted_truncated": len(text) > READ_TEXT_PREVIEW_BYTES,
        "max_bytes": max_bytes,
    })
    receipt_path = _publish_evidence(evidence_dir, payload)
    return {
        "schema": BROKER_OPERATION_SCHEMA,
        "ok": True,
        "op": "read",
        "op_id": op_id,
        "receipt_path": str(receipt_path),
        "url_original": url,
        "url_final": response.final_url,
        "redirect_chain": response.redirect_chain,
        "status_code": response.status_code,
        "content_type": content_type,
        "title": title,
        "response_bytes": len(response.body),
        "response_sha256": payload["response_sha256"],
        "extracted_bytes": len(text),
        "extracted_sha256": text_sha,
        "extracted_preview": text[:READ_TEXT_PREVIEW_BYTES],
        "extracted_truncated": len(text) > READ_TEXT_PREVIEW_BYTES,
        "broker_version": BROKER_VERSION,
    }


def _op_asset_read(args: argparse.Namespace) -> dict[str, Any]:
    """op=asset-read: fetch a public asset, retain content-addressed bytes."""
    url = args.url
    max_bytes = int(args.max_bytes) if args.max_bytes else ASSET_DEFAULT_MAX_BYTES
    evidence_dir = Path(args.evidence_dir).expanduser()
    response = _browse(url, max_bytes=max_bytes,
                       accept="*/*")
    if response.status_code != 200:
        raise TransientFailure(
            f"asset upstream returned HTTP {response.status_code} {response.reason}"
        )
    content_type = (response.headers.get("content-type") or "application/octet-stream").split(";", 1)[0].strip().lower()
    if content_type not in ASSET_MIME_ALLOWLIST:
        raise InvalidRequest(
            f"asset content-type refused by allowlist: {content_type!r}"
        )
    digest = hashlib.sha256(response.body).hexdigest()
    safe_ext = _safe_ext_for_mime(content_type)
    artifact_path = _publish_artifact(
        evidence_dir, _op_id(), digest, safe_ext, response.body
    )
    # Determine legitimacy signals visible at the response (none for
    # asset-only endpoints; the receipt records this explicitly so the
    # worker can decide to inspect the upstream page if it cares).
    op_id = _op_id()
    payload = _receipt_base(args, "asset-read")
    payload.update({
        "finished_at": _now_iso(),
        "url_original": url,
        "url_final": response.final_url,
        "redirect_chain": response.redirect_chain,
        "connect_log": response.connect_log,
        "status_code": response.status_code,
        "content_type": content_type,
        "asset_sha256": digest,
        "asset_bytes": len(response.body),
        "artifact_path": str(artifact_path),
        "legitimacy": "ambiguous",
        "legitimacy_signals": {
            "license_header": response.headers.get("x-license", ""),
            "license_link_header": response.headers.get("link", ""),
        },
        "usage_hints": [],
    })
    receipt_path = _publish_evidence(evidence_dir, payload)
    return {
        "schema": BROKER_OPERATION_SCHEMA,
        "ok": True,
        "op": "asset-read",
        "op_id": op_id,
        "receipt_path": str(receipt_path),
        "artifact_path": str(artifact_path),
        "url_original": url,
        "url_final": response.final_url,
        "redirect_chain": response.redirect_chain,
        "status_code": response.status_code,
        "content_type": content_type,
        "asset_bytes": len(response.body),
        "asset_sha256": digest,
        "legitimacy": "ambiguous",
        "broker_version": BROKER_VERSION,
    }


_REQUEST_ID_RE = _re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
)
_REQUEST_DIGEST_RE = _re.compile(r"^[0-9a-f]{64}$")
_RUN_ID_RE = _re.compile(r"^run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$")
_ATTEMPT_ID_RE = _re.compile(r"^[A-Za-z0-9._:-]{1,64}$")


def _validate_common(args: argparse.Namespace) -> None:
    """Common argument guards; raises InvalidRequest on failure."""
    if args.kind is not None and len(args.kind.encode("utf-8")) > args.kind_cap:
        raise InvalidRequest(
            f"--kind exceeds {args.kind_cap} bytes after utf-8 encoding"
        )
    if not args.run_id or not args.attempt:
        raise InvalidRequest("--run-id and --attempt are required")
    if not args.evidence_dir:
        raise InvalidRequest("--evidence-dir is required")
    # The bridge gives every request a UUIDv4 request_id and a
    # 64-char hex request_digest. The broker refuses anything else so
    # a prompt-injected worker cannot smuggle arbitrary free-form text
    # into receipts (which become part of the durable audit trail).
    if not args.request_id or not _REQUEST_ID_RE.match(args.request_id):
        raise InvalidRequest(
            "--request-id must be a UUIDv4 (8-4-4-4-12 lowercase hex)"
        )
    if args.request_digest and not _REQUEST_DIGEST_RE.match(args.request_digest):
        raise InvalidRequest(
            "--request-digest must be a 64-char lowercase hex SHA256"
        )
    if not _RUN_ID_RE.match(args.run_id):
        raise InvalidRequest("run-id does not match canonical format")
    if not _ATTEMPT_ID_RE.match(args.attempt):
        raise InvalidRequest("attempt has unsafe characters")


# -------------------------------------------------------------------- #
# main                                                                   #
# -------------------------------------------------------------------- #


CANARY_VERSION = 1
CANARY_RESULT_SCHEMA = "ownframework-loop-privileged-canary/v1"


def _emit_canary(
    name: str,
    fingerprint: str,
    canary_kind: str,
    contract_revision: str,
) -> dict[str, Any]:
    """Privilege-protocol canary envelope.

    Mirrors the ``ownframework-loop-privileged-canary/v1`` schema the
    canonical ``commission_capability`` resolver expects. The broker's
    canary self-test refuses the private/loopback address ranges via
    the same SSRF primitives a real op=read uses; if the boundary
    drifts, the canary fails and the resolver refuses to seal the
    commissioning evidence.
    """
    # Self-test 1: loopback refused.
    try:
        _resolve_and_validate("127.0.0.1")
        refused_loopback = False
    except (SSRFRefused, BrokerError):
        refused_loopback = True
    # Self-test 2: rfc1918 refused.
    try:
        _resolve_and_validate("10.0.0.1")
        refused_rfc1918 = False
    except (SSRFRefused, BrokerError):
        refused_rfc1918 = True
    # Self-test 3: private v6 refused.
    try:
        _resolve_and_validate("fc00::1")
        refused_v6_unique_local = False
    except (SSRFRefused, BrokerError):
        refused_v6_unique_local = True
    # Self-test 4: TEST-NET-1 (documentation) refused.
    try:
        _resolve_and_validate("192.0.2.1")
        refused_test_net = False
    except (SSRFRefused, BrokerError):
        refused_test_net = True
    # Self-test 5: benchmarking range refused.
    try:
        _resolve_and_validate("198.18.0.1")
        refused_benchmark = False
    except (SSRFRefused, BrokerError):
        refused_benchmark = True
    # Self-test 6: IPv4-mapped IPv6 v4 rules still fire.
    try:
        _classify_address(
            socket.AF_INET6, "::ffff:127.0.0.1",
        )
        # If we got here, the v4 rule did NOT fire — broker drifted.
        refused_v4_mapped = False
    except Exception:
        refused_v4_mapped = True
    # Self-test 7: URL with userinfo refused.
    try:
        _parse_url("https://user:pass@example.com/")
        refused_userinfo = False
    except (ForbiddenHeader, BrokerError):
        refused_userinfo = True
    # Self-test 8: file:// scheme refused.
    try:
        _parse_url("file:///etc/passwd")
        refused_file_scheme = False
    except (InvalidRequest, BrokerError):
        refused_file_scheme = True
    if not all([
        refused_loopback, refused_rfc1918, refused_v6_unique_local,
        refused_test_net, refused_benchmark, refused_v4_mapped,
        refused_userinfo, refused_file_scheme,
    ]):
        return {
            "schema": CANARY_RESULT_SCHEMA,
            "ok": False,
            "error": (
                f"research broker boundary drifted: loopback={refused_loopback} "
                f"rfc1918={refused_rfc1918} v6={refused_v6_unique_local} "
                f"test_net={refused_test_net} benchmark={refused_benchmark} "
                f"v4_mapped={refused_v4_mapped} "
                f"userinfo={refused_userinfo} file_scheme={refused_file_scheme}"
            ),
        }
    if not all([
        refused_loopback, refused_rfc1918, refused_v6_unique_local,
        refused_userinfo, refused_file_scheme,
    ]):
        return {
            "schema": CANARY_RESULT_SCHEMA,
            "ok": False,
            "error": (
                f"research broker boundary drifted: loopback={refused_loopback} "
                f"rfc1918={refused_rfc1918} v6={refused_v6_unique_local} "
                f"userinfo={refused_userinfo} file_scheme={refused_file_scheme}"
            ),
        }
    return {
        "schema": CANARY_RESULT_SCHEMA,
        "ok": True,
        "capability": name,
        "capability_contract_revision": contract_revision,
        "semantic_runtime_fingerprint": fingerprint,
        "provider": "core_research_broker",
        "canary_kind": canary_kind,
        "canary_version": CANARY_VERSION,
    }


def _handle_capability_canary(argv: list[str]) -> int:
    """Entry point for ``--ofloop-capability-canary <cap> <fp> <kind> <rev>``.

    The canonical commissioning protocol invokes the canary_executable
    with this exact positional arg list and expects a JSON envelope that
    matches ``ownframework-loop-privileged-canary/v1`` exactly. The
    supplier of those exact values is the broker itself.
    """
    if len(argv) < 6:
        print(json.dumps({
            "schema": CANARY_RESULT_SCHEMA, "ok": False,
            "error_class": "InvalidRequest",
            "error": "expected 4 positional args after --ofloop-capability-canary",
        }, sort_keys=True))
        return 2
    name = str(argv[2])
    fingerprint = str(argv[3])
    canary_kind = str(argv[4])
    contract_revision = str(argv[5])
    result = _emit_canary(name, fingerprint, canary_kind, contract_revision)
    print(json.dumps(result, sort_keys=True))
    return 0 if result.get("ok") else 1


def main(argv: list[str]) -> int:
    _ignore_sigpipe()
    _set_resource_limits()
    # The privileged-capability commissioning harness invokes the canary
    # executable with a fixed positional arg list. Detect that form
    # BEFORE argparse so the broker can be its own canary.
    if (
        len(argv) >= 5
        and argv[1] == "--ofloop-capability-canary"
    ):
        return _handle_capability_canary(argv)
    try:
        # Build a fresh-from-environ copy for sending outbound (defence in
        # depth against any credential leak inherited from the worker
        # subprocess env).
        os.environ = _scrub_environment(dict(os.environ))  # type: ignore[assignment]
        args = _build_parser().parse_args(argv[1:])
        if args.op == "ping":
            print(json.dumps(_identity_record(argv), sort_keys=True))
            return 0
        if args.op == "help":
            print(json.dumps(_emit_help(), sort_keys=True))
            return 0
        # All bounded operations share common argument guards.
        if args.op == "search":
            _validate_common(args)
            if not args.query:
                raise InvalidRequest("--query is required for op=search")
            print(json.dumps(_op_search(args), sort_keys=True))
            return 0
        if args.op == "read":
            _validate_common(args)
            if not args.url:
                raise InvalidRequest("--url is required for op=read")
            print(json.dumps(_op_read(args), sort_keys=True))
            return 0
        if args.op == "asset-read":
            _validate_common(args)
            if not args.url:
                raise InvalidRequest("--url is required for op=asset-read")
            print(json.dumps(_op_asset_read(args), sort_keys=True))
            return 0
        err = {
            "schema": BROKER_OPERATION_SCHEMA,
            "ok": False,
            "error_class": "InvalidRequest",
            "error": f"unknown op: {args.op}",
        }
        print(json.dumps(err, sort_keys=True))
        return 2
    except BrokerError as exc:
        sys.stdout.write(json.dumps(exc.to_dict(), sort_keys=True) + "\n")
        sys.stdout.flush()
        return 1
    except KeyboardInterrupt:
        return 130
    except SystemExit:
        raise
    except Exception as exc:  # noqa: BLE001 -- fail closed at the CLI
        err = {
            "schema": BROKER_OPERATION_SCHEMA,
            "ok": False,
            "error_class": type(exc).__name__,
            "error": str(exc),
        }
        sys.stdout.write(json.dumps(err, sort_keys=True) + "\n")
        sys.stdout.flush()
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
