#!/usr/bin/env python3
"""OwnFramework Loop governed research request helper.

The semantic worker's ONE AND ONLY public-research surface. This
binary is in the worker's ``allowRead`` and PATH (added by the
``research.public`` capability resolution). The worker invokes
this helper from sandboxed Bash. The helper has no network
authority of its own — it can only write to the worker's own
per-run request inbox (operator-owned) and read from the
per-run response directory (operator-owned, supervisor-writable,
worker-readable).

Authority invariants (enforced in the helper itself):

* ``request_id`` is exactly a UUID4 string. No path separators,
  no control characters, no overlong values, no free-form text.
  This is the ONLY identifier that ever becomes part of a
  filesystem path under the bridge — the supervisor derives the
  final canonical response path from this single field plus
  run + attempt + role. A prompt-injected worker cannot
  escape the response root by controlling any other field.
* The request inbox path is taken from
  ``OFLOOP_RESEARCH_REQUESTS`` and is the worker's OWN run-scoped
  inbox only. The worker cannot publish into another run's
  inbox because the supervisor derives the inbox from the
  run context frozen in the capability binding.
* The response directory path is taken from
  ``OFLOOP_RESEARCH_RESPONSES``. The helper does NOT create any
  marker file there — the supervisor is the only writer.

Flow:

    1. Worker invokes
       ``ofloop-research-call --op read --url <u> --request-id <UUIDv4> ...``.
    2. Helper validates request shape (UUID4, run/attempt/role
       non-empty, url/query shape, no userinfo, no credentials).
    3. Helper atomically publishes an immutable REQUEST file to
       ``$OFLOOP_RESEARCH_REQUESTS/req-<UUIDv4>.json``.
    4. Helper blocks waiting for the supervisor's RESPONSE file at
       ``$OFLOOP_RESEARCH_RESPONSES/resp-<UUIDv4>.json``;
       polls every ``--poll-ms`` up to ``--timeout-seconds``.
    5. When the supervisor publishes the response, the helper reads
       it and emits the response body on stdout. On timeout /
       failure the helper emits a structured ``BrokerError``
       envelope and exits non-zero.

The helper is **not** authoritative. The supervisor validates the
request against the run's frozen capability binding AND the live
DB (run + active attempt + worker pid alive) before the broker is
invoked. The broker validates SSRF before any network attempt.
The worker cannot widen its authority by writing a malformed
request — every layer fails closed.
"""
from __future__ import annotations

import argparse
import datetime as _dt
import json
import os
import re as _re
import sys
import time
import uuid as _uuid

REQUEST_SCHEMA = "ownframework-loop-research-request/v1"
RESPONSE_SCHEMA = "ownframework-loop-research-response/v1"

VALID_OPS = ("search", "read", "asset-read")
VALID_ROLES = ("builder", "reviewer")

# Strict request-id format: exactly a UUID4 lowercase with hyphens.
# This is the ONLY path-bearing identifier the worker controls;
# every other identifier is canonical (run_id regex, attempt_id
# regex, role enum). Restricting request_id to a single fixed
# format means a prompt-injected worker cannot craft a request
# that escapes the response root via path traversal in the id.
REQUEST_ID_RE = _re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
)

# Canonical run-id and attempt-id allow shapes (used to defend
# against hostile payloads before the supervisor validates again
# — defence in depth, not authority).
RUN_ID_RE = _re.compile(r"^run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$")
ATTEMPT_ID_RE = _re.compile(r"^[A-Za-z0-9._:-]{1,64}$")

# Cheap pre-screen for userinfo and obvious dangerous schemes.
# The broker is authoritative; this is just enough to refuse
# to *queue* an obviously-invalid request.
USERINFO_RE = _re.compile(r"://[^/]*@")


class HelperError(Exception):
    code: str = "HelperError"

    def __init__(self, msg: str, *, code: str | None = None) -> None:
        super().__init__(msg)
        if code is not None:
            self.code = code

    def to_dict(self) -> dict[str, Any]:
        return {
            "schema": RESPONSE_SCHEMA,
            "ok": False,
            "error_class": self.code,
            "error": str(self),
            "timestamp": _dt.datetime.now(_dt.timezone.utc).isoformat(),
        }


def _check_shape(args: argparse.Namespace) -> None:
    """Argument-shape checks only (no SSRF, no DNS).

    SSRF / destination validation lives in the broker, run by the
    supervisor under its own network namespace. This helper only
    refuses malformed argument shapes so the helper can't be used
    as an SSRF bypass or a response-forgery primitive.
    """
    if args.op not in VALID_OPS:
        raise HelperError(f"op must be one of {VALID_OPS}", code="InvalidRequest")
    if args.role not in VALID_ROLES:
        raise HelperError(
            f"role must be one of {VALID_ROLES}", code="InvalidRequest"
        )
    if not args.run_id or not args.attempt:
        raise HelperError(
            "--run-id, --attempt are required", code="InvalidRequest"
        )
    # Strict canonical id checks (defence in depth; the supervisor
    # validates again at request consumption).
    if not RUN_ID_RE.match(args.run_id or ""):
        raise HelperError(
            "run_id does not match canonical OwnFramework Loop run-id format",
            code="InvalidRequest",
        )
    if not ATTEMPT_ID_RE.match(args.attempt or ""):
        raise HelperError(
            "attempt_id has unsafe characters", code="InvalidRequest",
        )
    if not args.request_id or not REQUEST_ID_RE.match(args.request_id):
        raise HelperError(
            "--request-id must be a UUID4 (8-4-4-4-12 lowercase hex)",
            code="InvalidRequest",
        )
    if args.op == "read" or args.op == "asset-read":
        if not args.url:
            raise HelperError(
                f"--url is required for op={args.op}", code="InvalidRequest",
            )
        if "://" not in args.url:
            raise HelperError("url must have scheme://", code="InvalidRequest")
        # Refuse any path-traversal-ish chars in the URL — the broker
        # will SSRF-validate the resolved address; we don't want a
        # request that even *looks* like a credential leak queued.
        if USERINFO_RE.search(args.url):
            raise HelperError(
                "url contains userinfo (refused pre-queue)",
                code="ForbiddenHeader",
            )
        if not args.url.lower().startswith(("https://", "http://")):
            raise HelperError(
                "url must use http(s) scheme (refused pre-queue)",
                code="InvalidRequest",
            )
    if args.op == "search":
        if not args.query:
            raise HelperError(
                "--query is required for op=search", code="InvalidRequest",
            )
        # Refuse obvious credential-shaped queries at the gate.
        bad_patterns = (
            _re.compile(r"\b[A-Za-z0-9_]{40,}\b"),
            _re.compile(r"(?i)\bgh[oprsu]_[A-Za-z0-9]{20,}\b"),
            _re.compile(r"-----BEGIN [A-Z ]+-----"),
            _re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
        )
        for pat in bad_patterns:
            if pat.search(args.query):
                raise HelperError(
                    "query contains credential-shaped token (refused pre-queue)",
                    code="ForbiddenHeader",
                )


def _atomic_write_json(path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{_uuid.uuid4().hex}.tmp")
    encoded = json.dumps(payload, sort_keys=True, ensure_ascii=True) + "\n"
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(encoded)
            fh.flush()
            os.fsync(fh.fileno())
        os.link(tmp, path)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def _canonical_request_payload(
    args: argparse.Namespace, request_digest: str,
) -> dict[str, Any]:
    """Build the REQUEST envelope.

    The ``canonical_request`` field is a JSON-canonical form of the
    operator-meaningful fields (everything except ``requested_at`` /
    ``kind``). It is what the supervisor and broker use to detect
    duplicate / replayed requests without depending on the
    ``request_id`` being globally unique.
    """
    canonical = {
        "schema": REQUEST_SCHEMA,
        "request_id": args.request_id,
        "run_id": args.run_id,
        "attempt_id": args.attempt,
        "role": args.role,
        "op": args.op,
        "url": args.url,
        "query": args.query,
        "max_bytes": int(args.max_bytes) if args.max_bytes is not None else None,
    }
    return {
        "schema": REQUEST_SCHEMA,
        "ok": True,
        "request_id": args.request_id,
        "run_id": args.run_id,
        "attempt_id": args.attempt,
        "role": args.role,
        "op": args.op,
        "url": args.url,
        "query": args.query,
        "max_bytes": int(args.max_bytes) if args.max_bytes is not None else None,
        "kind": args.kind,
        "requested_at": _dt.datetime.now(_dt.timezone.utc).isoformat(),
        "request_digest": request_digest,
        "canonical_request": canonical,
    }


def _compute_request_digest(payload: dict[str, Any]) -> str:
    """Deterministic digest over the canonical request fields."""
    import hashlib
    canonical = payload.get("canonical_request") or {}
    encoded = json.dumps(canonical, sort_keys=True, ensure_ascii=True, separators=(",", ":"))
    return hashlib.sha256(encoded.encode("utf-8")).hexdigest()


def main() -> int:
    p = argparse.ArgumentParser(prog="ofloop-research-call")
    p.add_argument("--op", required=True, choices=VALID_OPS)
    p.add_argument("--url", default=None)
    p.add_argument("--query", default=None)
    p.add_argument("--max-bytes", type=int, default=None)
    p.add_argument("--kind", default=None)
    p.add_argument("--request-id", default=None)
    p.add_argument("--run-id", default=None)
    p.add_argument("--attempt", default=None)
    p.add_argument("--role", default=None, choices=VALID_ROLES)
    p.add_argument("--poll-ms", type=int, default=200)
    p.add_argument("--timeout-seconds", type=float, default=90.0)
    args = p.parse_args()

    try:
        _check_shape(args)
    except HelperError as exc:
        print(json.dumps(exc.to_dict(), sort_keys=True), flush=True)
        return 2

    # Required env vars set by the capability resolver at attempt
    # launch time. Without them the helper has no path to a real
    # transport and must refuse rather than silently succeed.
    requests_dir = os.environ.get("OFLOOP_RESEARCH_REQUESTS", "").strip()
    responses_dir = os.environ.get("OFLOOP_RESEARCH_RESPONSES", "").strip()
    if not requests_dir or not responses_dir:
        err = {
            "schema": RESPONSE_SCHEMA,
            "ok": False,
            "error_class": "ConfigurationError",
            "error": "OFLOOP_RESEARCH_REQUESTS / OFLOOP_RESEARCH_RESPONSES unset",
            "timestamp": _dt.datetime.now(_dt.timezone.utc).isoformat(),
        }
        print(json.dumps(err, sort_keys=True), flush=True)
        return 3

    from pathlib import Path
    requests_dir_p = Path(requests_dir)
    responses_dir_p = Path(responses_dir)

    request = _canonical_request_payload(args, request_digest="")
    request["request_digest"] = _compute_request_digest(request)
    request_path = requests_dir_p / f"req-{args.request_id}.json"
    try:
        _atomic_write_json(request_path, request)
    except OSError as exc:
        err = {
            "schema": RESPONSE_SCHEMA,
            "ok": False,
            "error_class": "RequestPublishFailed",
            "error": str(exc),
            "timestamp": _dt.datetime.now(_dt.timezone.utc).isoformat(),
        }
        print(json.dumps(err, sort_keys=True), flush=True)
        return 4

    # Poll for response. The helper does NOT create any marker
    # file in the responses dir; the supervisor is the only writer
    # and must publish an authoritative response (or surface an
    # error path) on its own clock.
    #
    # Response binding (RESPECT THE EXACT SEMANTIC REQUEST):
    # the response MUST come back bound to the exact (request_id,
    # request_digest) the helper just submitted. A response under
    # the same request_id but a different request_digest OR
    # missing the digest field MUST fail closed — returning that
    # response as success would silently misattribute a different
    # semantic request's results to the caller's flow.
    deadline = time.monotonic() + float(args.timeout_seconds)
    poll_ms = max(50, int(args.poll_ms))
    response_path = responses_dir_p / f"resp-{args.request_id}.json"
    submitted_digest = request["request_digest"]
    while time.monotonic() < deadline:
        if response_path.exists():
            try:
                with response_path.open("r", encoding="utf-8") as fh:
                    raw = fh.read()
            except OSError as exc:
                err = {
                    "schema": RESPONSE_SCHEMA,
                    "ok": False,
                    "error_class": "ResponseReadFailed",
                    "error": str(exc),
                }
                print(json.dumps(err, sort_keys=True), flush=True)
                return 5
            try:
                envelope = json.loads(raw)
            except (OSError, ValueError) as exc:
                err = {
                    "schema": RESPONSE_SCHEMA,
                    "ok": False,
                    "error_class": "ResponseBindingFailed",
                    "error": (
                        f"response at {response_path} is not valid JSON: {exc}"
                    ),
                    "request_id": args.request_id,
                    "expected_request_digest": submitted_digest,
                    "timestamp": _dt.datetime.now(_dt.timezone.utc).isoformat(),
                }
                print(json.dumps(err, sort_keys=True), flush=True)
                return 5
            if not isinstance(envelope, dict):
                envelope = {}
            resp_schema = str(envelope.get("schema") or "")
            resp_request_id = str(envelope.get("request_id") or "")
            resp_request_digest = str(
                envelope.get("request_digest") or ""
            )
            binding_failures: list[str] = []
            if resp_schema != RESPONSE_SCHEMA:
                binding_failures.append(
                    f"schema mismatch: expected {RESPONSE_SCHEMA!r} "
                    f"got {resp_schema!r}"
                )
            if resp_request_id != args.request_id:
                binding_failures.append(
                    f"request_id mismatch: expected {args.request_id!r} "
                    f"got {resp_request_id!r}"
                )
            if resp_request_digest != submitted_digest:
                binding_failures.append(
                    f"request_digest mismatch: expected {submitted_digest!r} "
                    f"got {resp_request_digest!r}"
                )
            if binding_failures:
                err = {
                    "schema": RESPONSE_SCHEMA,
                    "ok": False,
                    "error_class": "ResponseBindingFailed",
                    "error": "; ".join(binding_failures),
                    "request_id": args.request_id,
                    "expected_request_digest": submitted_digest,
                    "observed_request_digest": resp_request_digest,
                    "timestamp": _dt.datetime.now(
                        _dt.timezone.utc
                    ).isoformat(),
                }
                print(json.dumps(err, sort_keys=True), flush=True)
                return 5
            sys.stdout.write(raw)
            sys.stdout.flush()
            return 0
        time.sleep(poll_ms / 1000.0)

    err = {
        "schema": RESPONSE_SCHEMA,
        "ok": False,
        "error_class": "ResponseTimeout",
        "error": f"no response within {args.timeout_seconds}s",
        "request_id": args.request_id,
        "timestamp": _dt.datetime.now(_dt.timezone.utc).isoformat(),
    }
    print(json.dumps(err, sort_keys=True), flush=True)
    return 6


if __name__ == "__main__":
    sys.exit(main())
