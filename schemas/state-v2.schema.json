{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ownframework.local/schemas/state-v2.schema.json",
  "title": "OwnFramework Loop State (PROGRAM v2)",
  "description": "Current PROGRAM STATE.json contract. It is the normal host-state shape plus a frozen program object; initialization changes the schema marker and adds program without replacing state history or host counters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "state",
    "state_history",
    "transitions_count",
    "build_pass_count",
    "review_pass_count",
    "repair_round",
    "no_progress_streak",
    "program"
  ],
  "properties": {
    "schema": {
      "const": "ownframework-loop-state/v2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "AWAITING_APPROVAL",
        "READY_TO_BUILD",
        "BUILDING",
        "READY_FOR_REVIEW",
        "REVIEWING",
        "CHANGES_REQUESTED",
        "APPROVED",
        "BLOCKED",
        "STOPPED"
      ]
    },
    "state_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "at",
          "actor"
        ],
        "properties": {
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "transitions_count": {
      "type": "integer",
      "minimum": 0
    },
    "build_pass_count": {
      "type": "integer",
      "minimum": 0
    },
    "review_pass_count": {
      "type": "integer",
      "minimum": 0
    },
    "repair_round": {
      "type": "integer",
      "minimum": 0
    },
    "no_progress_streak": {
      "type": "integer",
      "minimum": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_actor": {
      "type": "string"
    },
    "terminal_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_candidate_sha": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "spec_baseline_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "spec_baseline_sha": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{7,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "spec_snapshot_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "identical_finding_streak": {
      "type": "integer",
      "minimum": 0
    },
    "last_must_fix_fingerprint": {
      "type": "string"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "checkpoint_graph_sha256",
        "promotion_policy",
        "current_checkpoints",
        "finalized_checkpoints",
        "cumulative_counters",
        "cumulative_ceilings",
        "checkpoints",
        "blocked",
        "source_sha_provenance"
      ],
      "properties": {
        "execution_mode": {
          "const": "program"
        },
        "checkpoint_graph_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "promotion_policy": {
          "type": "string",
          "enum": [
            "human_gate",
            "merge_on_approved"
          ]
        },
        "current_checkpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CP-[0-9]+$"
          }
        },
        "finalized_checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "terminal_state",
              "finalized_at",
              "evidence_sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^CP-[0-9]+$"
              },
              "terminal_state": {
                "type": "string",
                "enum": [
                  "APPROVED",
                  "BLOCKED",
                  "STOPPED"
                ]
              },
              "finalized_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "cumulative_counters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build_pass_count",
            "review_pass_count",
            "repair_round_count",
            "files_changed_unique",
            "diff_lines_total"
          ],
          "properties": {
            "build_pass_count": {
              "type": "integer",
              "minimum": 0
            },
            "review_pass_count": {
              "type": "integer",
              "minimum": 0
            },
            "repair_round_count": {
              "type": "integer",
              "minimum": 0
            },
            "files_changed_unique": {
              "type": "integer",
              "minimum": 0
            },
            "diff_lines_total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cumulative_ceilings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_build_passes",
            "max_review_passes",
            "max_repair_rounds",
            "max_unique_changed_files",
            "max_baseline_to_final_diff_lines"
          ],
          "properties": {
            "max_build_passes": {
              "type": "integer",
              "minimum": 1
            },
            "max_review_passes": {
              "type": "integer",
              "minimum": 1
            },
            "max_repair_rounds": {
              "type": "integer",
              "minimum": 1
            },
            "max_unique_changed_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "max_baseline_to_final_diff_lines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            }
          }
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "build_pass_count",
              "review_pass_count",
              "repair_round_count",
              "no_progress_streak",
              "candidate_sha",
              "build_receipt_sha256",
              "verdict_sha256",
              "terminal"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^CP-[0-9]+$"
              },
              "build_pass_count": {
                "type": "integer",
                "minimum": 0
              },
              "review_pass_count": {
                "type": "integer",
                "minimum": 0
              },
              "repair_round_count": {
                "type": "integer",
                "minimum": 0
              },
              "no_progress_streak": {
                "type": "integer",
                "minimum": 0
              },
              "candidate_sha": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{7,64}$"
              },
              "build_receipt_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "verdict_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "terminal": {
                "type": "string",
                "enum": [
                  "",
                  "APPROVED",
                  "BLOCKED",
                  "STOPPED"
                ]
              },
              "last_evidence_sha_by_counter": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "build_pass_count": {
                    "type": "string"
                  },
                  "review_pass_count": {
                    "type": "string"
                  },
                  "repair_round_count": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "blocked": {
          "type": "boolean"
        },
        "block_reason": {
          "type": "string"
        },
        "source_sha_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_sha",
            "candidate_branch",
            "captured_at",
            "envelope_source",
            "packet_global_cap",
            "checkpoint_sum_cap"
          ],
          "properties": {
            "baseline_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{7,64}$"
            },
            "candidate_branch": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "type": "string",
              "format": "date-time"
            },
            "envelope_source": {
              "type": "string"
            },
            "packet_global_cap": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_build_passes",
                "max_review_passes",
                "max_repair_rounds"
              ],
              "properties": {
                "max_build_passes": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_review_passes": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_repair_rounds": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "checkpoint_sum_cap": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_build_passes",
                "max_review_passes",
                "max_repair_rounds"
              ],
              "properties": {
                "max_build_passes": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_review_passes": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_repair_rounds": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
