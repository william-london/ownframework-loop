{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ownframework.local/schemas/approval.schema.json",
  "title": "OwnFramework Loop Execution Binding",
  "description": "Current execution-binding contract stored at the historical APPROVAL.json path. Normal runs use approval_method=build_start with binding_kind=execution_seal; tty_confirmation remains a compatibility pre-seal. The artifact binds exact packet bytes, canonical repository, baseline branch/SHA, and candidate branch. Packet bytes are immutable after the binding is created.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "packet_sha256",
    "approved_at",
    "approved_actor",
    "canonical_repo",
    "baseline_branch",
    "baseline_sha",
    "packet_schema",
    "approval_method",
    "confirmation_token",
    "candidate_branch"
  ],
  "properties": {
    "schema": {
      "const": "ownframework-loop-approval/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "canonical_repo": {
      "type": "string",
      "minLength": 1
    },
    "baseline_branch": {
      "type": "string",
      "minLength": 1
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "packet_schema": {
      "type": "string",
      "enum": [
        "ownframework-work-packet/v1",
        "ownframework-work-packet/v2",
        "ownframework-work-packet/v3",
        "ownframework-work-packet/v4"
      ]
    },
    "approval_method": {
      "type": "string",
      "enum": [
        "build_start",
        "tty_confirmation",
        "mission_segment"
      ]
    },
    "binding_kind": {
      "type": "string",
      "enum": [
        "execution_seal",
        "legacy_preseal",
        "mission_derived_seal"
      ]
    },
    "confirmation_token": {
      "type": "string",
      "minLength": 6,
      "maxLength": 64
    },
    "operator_note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "packet_work_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "packet_risk_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "packet_title": {
      "type": [
        "string",
        "null"
      ]
    },
    "sensitive_paths_in_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "elevated_paths_in_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_branch": {
      "type": "string",
      "minLength": 1
    },
    "mission_origin_approval_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mission_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "mission_id",
        "segment_number",
        "predecessor_run_id",
        "mission_authority_sha256",
        "segment_authority_sha256"
      ],
      "properties": {
        "schema": { "const": "ownframework-loop-mission-segment-approval/v1" },
        "mission_id": { "type": "string", "pattern": "^mission-[a-f0-9]{24}$" },
        "segment_number": { "type": "integer", "minimum": 1, "maximum": 16 },
        "predecessor_run_id": { "type": ["string", "null"] },
        "mission_authority_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "segment_authority_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "spec_baseline_branch": {
      "type": "string",
      "minLength": 1
    },
    "spec_baseline_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "spec_snapshot_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
