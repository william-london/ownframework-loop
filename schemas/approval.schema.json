{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ownframework.local/schemas/approval.schema.json",
  "title": "OwnFramework Loop APPROVAL",
  "description": "Separate, deterministic, external approval artifact. The WORK_PACKET.md bytes are authenticator; the approval binds them to a human terminal action and a specific canonical repository, baseline branch, and baseline SHA. Packet bytes remain unchanged after approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "packet_sha256",
    "approved_at",
    "approved_actor",
    "canonical_repo",
    "baseline_branch",
    "baseline_sha",
    "packet_schema",
    "approval_method",
    "confirmation_token"
  ],
  "properties": {
    "schema": { "const": "ownframework-loop-approval/v1" },
    "run_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "minLength": 1, "maxLength": 64 },
    "packet_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approved_at": { "type": "string", "format": "date-time" },
    "approved_actor": { "type": "string", "minLength": 1, "maxLength": 64 },
    "canonical_repo": { "type": "string", "minLength": 1 },
    "baseline_branch": { "type": "string", "minLength": 1 },
    "baseline_sha": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "packet_schema": { "type": "string", "minLength": 1 },
    "approval_method": { "type": "string", "enum": ["tty_confirmation", "operator_marker"] },
    "confirmation_token": { "type": "string", "minLength": 6, "maxLength": 16 },
    "operator_note": { "type": "string", "maxLength": 1000 },
    "packet_work_class": { "type": "string" },
    "packet_risk_class": { "type": "string" },
    "packet_title": { "type": "string" },
    "sensitive_paths_in_scope": { "type": "array", "items": { "type": "string" } },
    "elevated_paths_in_scope": { "type": "array", "items": { "type": "string" } }
  }
}
